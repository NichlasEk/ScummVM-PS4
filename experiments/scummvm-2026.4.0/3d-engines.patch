 static void readPixels(int x, int y, int width, int height, byte *buffer) {
+#ifdef __PS4__
+	// EMI splits the screen into eight power-of-two textures. Read each tile
+	// once, not once per row (each bridge readback submits and waits for GPU).
+	// Bottom tiles extend past 480 pixels; pad that unused area explicitly.
+	const int screenWidth = g_system->getWidth();
+	const int screenHeight = g_system->getHeight();
+	const int copyWidth = MIN(width, MAX(0, screenWidth - x));
+	const int copyHeight = MIN(height, MAX(0, screenHeight - y));
+	memset(buffer, 0, width * height * 4);
+	if (!copyWidth || !copyHeight)
+		return;
+	g_system->updateScreen();
+	Common::Array<byte> pixels;
+	pixels.resize(copyWidth * copyHeight * 4);
+	glReadPixels(x, screenHeight - y - copyHeight, copyWidth, copyHeight, GL_RGBA, GL_UNSIGNED_BYTE, pixels.begin());
+	const GLenum captureError = glGetError();
+	if (captureError != GL_NO_ERROR)
+		error("PS4 Grim screen tile: readback failed at %d,%d size=%dx%d GL=0x%x", x, y, copyWidth, copyHeight, captureError);
+	for (int row = 0; row < copyHeight; ++row)
+		memcpy(buffer + row * width * 4, pixels.begin() + (copyHeight - row - 1) * copyWidth * 4, copyWidth * 4);
+	debug(1, "PS4 Grim screen tile: %d,%d %dx%d captured in one readback", x, y, copyWidth, copyHeight);
+#else
 	byte *p = buffer;
 	for (int i = y; i < y + height; i++) {
 		glReadPixels(x, 479 - i, width, 1, GL_RGBA, GL_UNSIGNED_BYTE, p);
 		p += width * 4;
 	}
+#endif
 }
 
