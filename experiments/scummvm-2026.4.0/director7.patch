+const Common::Array<int> &Score::getPS4ChannelOrder() {
+	bool changed = _ps4ChannelPriorities.size() != _channels.size();
+	if (changed) {
+		_ps4ChannelPriorities.resize(_channels.size());
+		_ps4ChannelOrder.resize(_channels.size());
+	}
+	for (uint i = 0; i < _channels.size(); ++i) {
+		const int priority = _channels[i]->_priority;
+		if (_ps4ChannelPriorities[i] != priority)
+			changed = true;
+		_ps4ChannelPriorities[i] = priority;
+	}
+	if (changed) {
+		for (uint i = 0; i < _channels.size(); ++i)
+			_ps4ChannelOrder[i] = i;
+		Common::sort(_ps4ChannelOrder.begin(), _ps4ChannelOrder.end(), [this](int a, int b) {
+			if (_ps4ChannelPriorities[a] != _ps4ChannelPriorities[b])
+				return _ps4ChannelPriorities[a] < _ps4ChannelPriorities[b];
+			return a < b;
+		});
+	}
+	return _ps4ChannelOrder;
+}
