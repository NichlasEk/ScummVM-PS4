+void Lingo::guardRecord(const char *event, const Symbol *symbol) {
+	if (!_guard || !_state)
+		return;
+	if (!symbol && !_state->callstack.empty())
+		symbol = &_state->callstack.back()->sp;
+	const void *object = _state->me.type == OBJECT ? _state->me.u.obj : nullptr;
+	if (symbol && symbol->target)
+		object = symbol->target;
+	_guard->record(event, symbol && symbol->name ? symbol->name->c_str() : "",
+	               _state, symbol ? symbol->ctx : _state->context, object,
+	               _state->pc, _state->stack.size(), _state->callstack.size());
+}
+
+void Lingo::guardReport(const char *reason, bool fatal) {
+	if (!_guard || (!fatal && _guard->reports >= 3))
+		return;
+	++_guard->reports;
+	guardRecord(fatal ? "fatal" : "script-error");
+	warning("EutherLingo Guard: %s (game=%s, report=%u, entries=%u)",
+	        reason, _vm->getGameId(), _guard->reports, _guard->size());
+	for (uint i = 0; i < _guard->size(); ++i) {
+		const EutherLingoGuard::Entry &e = _guard->at(i);
+		debug("ELG %u %s handler=%s state=%p context=%p object=%p pc=%u stack=%u depth=%u",
+		      i, e.event, e.handler, e.state, e.context, e.object, e.pc, e.stack, e.depth);
+	}
+}
+
+void Lingo::guardCheckArguments(int nargs) {
+	if (nargs < 0 || (uint)nargs > _state->stack.size()) {
+		guardReport("invalid argument stack", true);
+		error("EutherLingo Guard: argument count %d exceeds available stack %u",
+		      nargs, _state->stack.size());
+	}
+}
+
+void Lingo::guardCheckPC() {
+	if (!_state->script || _state->pc >= _state->script->size()) {
+		guardReport("invalid instruction position", true);
+		error("EutherLingo Guard: instruction position %u outside script", _state->pc);
+	}
+}
