+// AIFF MARK positions are sample frames; Director cue times are milliseconds.
+void loadLinkedAIFFCues(const Common::String &path, Common::Array<int32> &times, Common::StringArray &names) {
+	Common::SeekableReadStream *stream = Common::MacResManager::openFileOrDataFork(findAudioPath(path));
+	if (!stream) return;
+	Common::Array<uint32> positions;
+	Common::StringArray labels;
+	uint32 rate = 0;
+	bool valid = stream->size() >= 12 && stream->readUint32BE() == MKTAG('F','O','R','M');
+	uint64 end = valid ? (uint64)stream->readUint32BE() + 8 : 0;
+	uint32 kind = valid ? stream->readUint32BE() : 0;
+	valid = valid && end >= 12 && end <= (uint64)stream->size() &&
+		(kind == MKTAG('A','I','F','F') || kind == MKTAG('A','I','F','C'));
+	while (valid && (uint64)stream->pos() + 8 <= end) {
+		uint32 tag = stream->readUint32BE();
+		uint32 size = stream->readUint32BE();
+		uint64 next = (uint64)stream->pos() + size;
+		if (next + (size & 1) > end) { valid = false; break; }
+		if (tag == MKTAG('C','O','M','M') && size >= 18) {
+			stream->skip(8);
+			uint16 exponent = stream->readUint16BE();
+			uint64 mantissa = stream->readUint64BE();
+			int shift = 63 - ((int)exponent - 16383);
+			if (shift >= 32 && shift <= 63) rate = (uint32)(mantissa >> shift);
+		} else if (tag == MKTAG('M','A','R','K') && size >= 2) {
+			uint16 count = stream->readUint16BE();
+			for (uint i = 0; valid && i < count; ++i) {
+				if ((uint64)stream->pos() + 7 > next) { valid = false; break; }
+				stream->readUint16BE(); // Authored ID; event numbers follow marker order.
+				uint32 position = stream->readUint32BE();
+				uint length = stream->readByte();
+				if ((uint64)stream->pos() + length + ((length + 1) & 1) > next) { valid = false; break; }
+				Common::String label;
+				for (uint j = 0; j < length; ++j) label += (char)stream->readByte();
+				if ((length + 1) & 1) stream->skip(1);
+				positions.push_back(position);
+				labels.push_back(label);
+			}
+		}
+		stream->seek(next + (size & 1));
+	}
+	if (valid && rate) {
+		for (uint i = 0; i < positions.size(); ++i) {
+			uint64 ms = (uint64)positions[i] * 1000 / rate;
+			if (ms > 0x7fffffff) continue;
+			times.push_back((int32)ms);
+			names.push_back(labels[i]);
+		}
+	}
+	delete stream;
+}
 
