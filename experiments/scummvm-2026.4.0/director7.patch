+
+	const Common::Rect &stage = _movie->_movieRect;
+	if (stage.width() < 16 || stage.height() < 16)
+		return false;
+	// Window::getMousePos() is already relative to the stage's inner origin.
+	// The movie rect may contain an authoring/desktop offset; adding that
+	// offset here separates the visible cursor from hover/click coordinates.
+	pos.x = CLIP<int>(pos.x, 8, stage.width() - 8);
+	pos.y = CLIP<int>(pos.y, 8, stage.height() - 8);
+	for (Channel *channel : _channels) {
+		if (!channel || !channel->_visible || channel->_priority != 0x7fffffff ||
+		    !channel->_sprite || !channel->_sprite->_cast ||
+		    channel->_sprite->_cast->_type != kCastBitmap)
