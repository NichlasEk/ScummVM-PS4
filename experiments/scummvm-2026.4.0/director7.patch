+// Jönsson uses the transparent "Ruta" bitmap as a quadrilateral hotspot.
+// Keep this hit geometry separate from rendering: this is not textured-quad
+// rasterization. Store offsets so camera/loc changes translate the same quad.
+void Channel::setPS4HitQuad(const Common::Array<Common::Point> &points) {
+	if (points.size() != 4)
+		return;
+	_ps4HitQuad = points;
+	const Common::Point origin = getPosition();
+	for (Common::Point &point : _ps4HitQuad)
+		point -= origin;
+}
+
+Common::Array<Common::Point> Channel::getPS4HitQuad() {
+	Common::Array<Common::Point> result = _ps4HitQuad;
+	const Common::Point origin = getPosition();
+	for (Common::Point &point : result)
+		point += origin;
+	return result;
+}
+
+bool Channel::hasPS4HitQuad() {
+	if (_ps4HitQuad.size() != 4 || !_sprite || !_sprite->_cast ||
+	    _sprite->_cast->_type != kCastBitmap)
+		return false;
+	CastMemberInfo *info = _sprite->_cast->getInfo();
+	return info && info->name.equalsIgnoreCase("Ruta");
+}
+
+Common::Rect Channel::getPS4HitQuadBounds() {
+	Common::Array<Common::Point> points = getPS4HitQuad();
+	if (points.size() != 4)
+		return Common::Rect();
+	Common::Rect bounds(points[0].x, points[0].y, points[0].x, points[0].y);
+	for (const Common::Point &point : points) {
+		bounds.left = MIN(bounds.left, point.x);
+		bounds.top = MIN(bounds.top, point.y);
+		bounds.right = MAX(bounds.right, point.x);
+		bounds.bottom = MAX(bounds.bottom, point.y);
+	}
+	return bounds;
+}
+
+bool Channel::isInPS4HitQuad(const Common::Point &pos) {
+	if (_ps4HitQuad.size() != 4)
+		return false;
+	const Common::Point p = pos - getPosition();
+	bool inside = false;
+	int64 area = 0;
+	for (uint i = 0, j = 3; i < 4; j = i++)
+		area += int64(_ps4HitQuad[j].x) * _ps4HitQuad[i].y - int64(_ps4HitQuad[i].x) * _ps4HitQuad[j].y;
+	if (!area)
+		return false;
+	for (uint i = 0, j = 3; i < 4; j = i++) {
+		const Common::Point &a = _ps4HitQuad[j], &b = _ps4HitQuad[i];
+		const int64 cross = int64(b.x - a.x) * (p.y - a.y) - int64(b.y - a.y) * (p.x - a.x);
+		if (!cross && p.x >= MIN(a.x, b.x) && p.x <= MAX(a.x, b.x) &&
+		    p.y >= MIN(a.y, b.y) && p.y <= MAX(a.y, b.y))
+			return true;
+		if ((a.y > p.y) != (b.y > p.y)) {
+			if ((b.y > a.y && cross > 0) || (b.y < a.y && cross < 0))
+				inside = !inside;
+		}
+	}
+	return inside;
+}
