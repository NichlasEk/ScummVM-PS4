+bool Score::updatePS4ScriptCursor(Common::Point pos) {
+	// Går på djupet hides the system cursor and moves a bitmap in script 41.
+	// Follow input between score frames; leave animation and interaction state
+	// to the original script. Do not apply this convention to other games.
+	if (!isPS4Jonsson() || Common::String(_vm->getGameId()) != "jonssonligan2" ||
+	    _playState != kPlayStarted || _window->_playbackPaused ||
+	    _movie->_videoPlayback || _movie->_isEmbedded)
