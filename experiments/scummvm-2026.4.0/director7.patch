+#ifndef DIRECTOR_EUTHERLINGO_GUARD_H
+#define DIRECTOR_EUTHERLINGO_GUARD_H
+
+#include "common/scummsys.h"
+
+namespace Director {
+
+// Bounded, value-only history: no Datum/Symbol ownership and no object dereferences.
+// Pointer values are opaque, process-local correlation tokens, not persistent IDs.
+class EutherLingoGuard {
+public:
+	struct Entry {
+		const char *event;
+		char handler[64];
+		const void *state;
+		const void *context;
+		const void *object;
+		uint pc, stack, depth;
+	};
+	enum { kCapacity = 128 };
+	EutherLingoGuard() : reports(0), _next(0), _count(0) {}
+
+	void record(const char *event, const char *handler, const void *state,
+	            const void *context, const void *object, uint pc, uint stack, uint depth) {
+		Entry &e = _entries[_next];
+		e.event = event;
+		uint i = 0;
+		if (handler) {
+			for (; i + 1 < sizeof(e.handler) && handler[i]; ++i)
+				e.handler[i] = handler[i];
+		}
+		e.handler[i] = 0;
+		e.state = state;
+		e.context = context;
+		e.object = object;
+		e.pc = pc;
+		e.stack = stack;
+		e.depth = depth;
+		_next = (_next + 1) % kCapacity;
+		if (_count < kCapacity)
+			++_count;
+	}
+
+	uint size() const { return _count; }
+	const Entry &at(uint i) const {
+		assert(i < _count);
+		return _entries[(_next + kCapacity - _count + i) % kCapacity];
+	}
+	uint reports;
+
+private:
+	Entry _entries[kCapacity];
+	uint _next, _count;
+};
+
+} // End of namespace Director
