+    return BitmapGlyph{
+        charCode,
+        imageFormat,
+        sign16(xPos & 0xFFFF),
+        sign16(yPos & 0xFFFF),
+        xSize,
+        ySize,
+        setWidth,
+        std::move(imageData)
+    };
