+// The PS4 backend exposes one fixed virtual display. DisplayRes must report
+// that display rather than attempt to change the host desktop resolution.
+class FixedDisplayRes : public Object<FixedDisplayRes> {
+public:
+ FixedDisplayRes() : Object<FixedDisplayRes>("DisplayRes") { _objType = kXtraObj; }
+};
+static void displayResRegister(int nargs) {
+ g_lingo->dropStack(nargs);
+ g_lingo->push(Datum(1));
+}
+static void displayResCurrent(int nargs) {
+ g_lingo->push(Datum(Common::String::format("%d %d %d 0 0 0 fixed",
+  g_system->getWidth(), g_system->getHeight(), g_system->getScreenFormat().bytesPerPixel * 8)));
+}
+static void displayResSet(int nargs) {
+ // Index 1 is the already-active, sole virtual mode; reject all other modes.
+ int mode = g_lingo->pop().asInt();
+ g_lingo->push(Datum(mode == 1 ? 1 : 0));
+}
+static void directorQuickTimeVersion(int nargs) { g_lingo->push(Datum(4)); }
+static Common::String preferenceFile(const Common::String &key) {
+ Common::String name = Common::String(g_director->getGameId()) + "-pref-";
+ for (uint i = 0; i < key.size(); ++i) name += Common::String::format("%02x", (byte)key[i]);
+ return name;
+}
+static void directorSetPref(int nargs) {
+ Common::String value = g_lingo->pop().asString();
+ Common::String key = g_lingo->pop().asString();
+ Common::OutSaveFile *out = g_system->getSavefileManager()->openForSaving(preferenceFile(key));
+ if (!out) { g_lingo->lingoError("SetPref: cannot open preferences"); return; }
+ out->write(value.c_str(), value.size()); out->finalize();
+ bool failed = out->err(); delete out;
+ if (failed) g_lingo->lingoError("SetPref: write failed");
+}
+static void directorGetPref(int nargs) {
+ Common::String key = g_lingo->pop().asString(), value;
+ Common::InSaveFile *in = g_system->getSavefileManager()->openForLoading(preferenceFile(key));
+ if (in) { while (!in->eos()) { char c = in->readByte(); if (!in->eos()) value += c; } delete in; }
+ g_lingo->push(Datum(value));
+}
+// TMS Tools returns one drive letter per CR-terminated line.
+// Jonssonligan 2 removes the trailing empty line before scanning the drives.
+static void toolsDriveList(int nargs) { g_lingo->push(Datum("D\r")); }
+static void toolsDriveType(int nargs) {
+ Common::String drive = g_lingo->pop().asString();
+ g_lingo->push(Datum(drive.equalsIgnoreCase("D:\\") ? 4 : 0));
+}
+static void toolsFileExists(int nargs) {
+ Common::String file = g_lingo->pop().asString();
+ if (file.hasPrefixIgnoreCase("D:\\")) file = file.substr(3);
+ Common::Path path = findPath(file, false);
+ g_lingo->push(Datum(SearchMan.hasFile(path) ? 1 : 0));
+}
+static void directorSetContents(int nargs) {
+ Datum value = g_lingo->pop();
+ Datum target = g_lingo->pop();
+ g_lingo->varAssign(target, value);
+}
+void openJonssonTools() {
+ static const BuiltinProto functions[] = {
+  { "setContents", directorSetContents, 2, 2, 700, CBLTIN },
+  { "QuickTimeVersion", directorQuickTimeVersion, 0, 0, 700, FBLTIN },
+  { "SetPref", directorSetPref, 2, 2, 700, CBLTIN },
+  { "GetPref", directorGetPref, 1, 1, 700, FBLTIN },
+  { "tMsRegisterTOOLS", displayResRegister, 1, 1, 700, HBLTIN },
+  { "tMsGetDriveList", toolsDriveList, 0, 0, 700, HBLTIN },
+  { "tMsGetDriveType", toolsDriveType, 1, 1, 700, HBLTIN },
+  { "tMsDoesFileExist", toolsFileExists, 1, 1, 700, HBLTIN },
+  { nullptr, nullptr, 0, 0, 0, VOIDSYM }
+ };
+ g_lingo->initBuiltIns(functions);
+}
+
+static void openFixedDisplayRes() {
+ static const MethodProto methods[] = {
+  { "register", displayResRegister, 1, 1, 700 },
+  { nullptr, nullptr, 0, 0, 0 }
+ };
+ static const BuiltinProto functions[] = {
+  { "dresGetDisplaySettings", displayResCurrent, 0, 0, 700, HBLTIN },
+  { "dresGetCurrentDisplay", displayResCurrent, 0, 0, 700, HBLTIN },
+  { "dresDynamicSetDisplay", displayResSet, 1, 1, 700, HBLTIN },
+  { nullptr, nullptr, 0, 0, 0, VOIDSYM }
+ };
+ FixedDisplayRes::initMethods(methods);
+ g_lingo->exposeXObject("DisplayRes", new FixedDisplayRes());
+ g_lingo->initBuiltIns(functions);
+}
