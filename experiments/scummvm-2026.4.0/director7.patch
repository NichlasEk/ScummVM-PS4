+// Index large immutable text values used by the Jonsson save/scene scripts.
+// Include the delimiter and compare contents, so field edits and changes to
+// itemDelimiter cannot reuse stale offsets. Small text keeps the original path.
+static bool indexedPS4ChunkBounds(const Common::U32String &text, Common::u32char_type_t delimiter,
+		int first, int last, int &count, int &chunkStart, int &chunkEnd, int &exprStart, int &exprEnd) {
+	if (!isPS4Jonsson() || text.size() < 1024 || text.size() > 1024 * 1024)
+		return false;
+	struct Entry {
+		Common::U32String text;
+		Common::u32char_type_t delimiter = 0;
+		Common::Array<int> starts;
+	};
+	static Entry cache[4];
+	static uint next = 0;
+	Entry *entry = nullptr;
+	for (uint i = 0; i < 4; ++i) {
+		if (cache[i].delimiter == delimiter && cache[i].text == text) {
+			entry = &cache[i];
+			break;
+		}
+	}
+	if (!entry) {
+		entry = &cache[next];
+		next = (next + 1) % 4;
+		entry->text = text;
+		entry->delimiter = delimiter;
+		entry->starts.clear();
+		entry->starts.push_back(0);
+		for (uint i = 0; i < text.size(); ++i)
+			if (text[i] == delimiter)
+				entry->starts.push_back(i + 1);
+	}
+	const Common::Array<int> &starts = entry->starts;
+	// Match the original scan, including an empty final chunk, out-of-range
+	// requests, reversed ranges and the special last-chunk sentinel.
+	count = last > 0 ? MIN(last, (int)starts.size()) : (int)starts.size();
+	chunkStart = starts[count - 1];
+	chunkEnd = count < (int)starts.size() ? starts[count] - 1 : text.size();
+	if (first > 0 && first <= count)
+		exprStart = starts[first - 1];
+	if (last == count)
+		exprEnd = chunkEnd;
+	return true;
+}
