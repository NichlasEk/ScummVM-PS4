+extern "C" bool director_pfr1_to_ttf(const unsigned char *data, size_t size, unsigned char **output, size_t *outputSize) {
+ *output = nullptr; *outputSize = 0;
+ if (!data || size < 58 || size > 4 * 1024 * 1024 || memcmp(data, "PFR1", 4)) return false;
+ try {
+  auto font = libreshockwave::font::Pfr1Font::parse(std::vector<uint8_t>(data, data + size));
+  if (!font || font->glyphs.empty() || font->glyphs.size() > 65534) return false;
+  auto ttf = libreshockwave::font::Pfr1TtfConverter::convert(*font, "Sand");
+  if (ttf.empty() || ttf.size() > 16 * 1024 * 1024) return false;
+  auto *buffer = static_cast<unsigned char *>(malloc(ttf.size()));
+  if (!buffer) return false;
+  memcpy(buffer, ttf.data(), ttf.size());
+  *output = buffer; *outputSize = ttf.size();
+  return true;
+ } catch (...) { return false; }
+}
+extern "C" void director_pfr1_free(unsigned char *data) { free(data); }
