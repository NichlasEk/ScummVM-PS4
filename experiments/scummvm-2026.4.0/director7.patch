+    int result = 0;
+    int remaining = count;
+    while (remaining > 0) {
+        if (bitsLeft_ == 0) {
+            if (position_ < 0 || position_ >= static_cast<int>(data_.size())) {
+                return result;
+            }
+            bitBuffer_ = data_[static_cast<std::size_t>(position_++)] & 0xFF;
+            bitsLeft_ = 8;
