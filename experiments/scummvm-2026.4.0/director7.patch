+#ifndef DIRECTOR_KEPATH_GRID_H
+#define DIRECTOR_KEPATH_GRID_H
+#include <algorithm>
+#include <cstdlib>
+#include <map>
+#include <queue>
+#include <utility>
+#include <vector>
+namespace Director {
+namespace KePathGrid {
+using Cell = std::pair<int, int>;
+// Path2 consumes a set of walkable grid cells. Paths omit the start cell.
+inline std::vector<Cell> find(const std::vector<Cell> &cells, Cell from, Cell to) {
+ std::vector<Cell> result;
+ if (from == to) return result;
+ std::map<Cell, int> ids;
+ for (unsigned i = 0; i < cells.size(); ++i) ids.emplace(cells[i], i);
+ auto a = ids.find(from), b = ids.find(to);
+ if (a == ids.end() || b == ids.end()) return result;
+ struct Node { int g = 0x3fffffff; int parent = -1; bool closed = false; };
+ struct Entry { int f, g, id; bool operator<(const Entry &o) const {
+  if (f != o.f) return f > o.f;
+  if (g != o.g) return g < o.g;
+  return id > o.id;
+ }};
+ auto heuristic = [&](Cell p) {
+  int x = std::abs(p.first - to.first), y = std::abs(p.second - to.second);
+  return 10 * std::max(x, y) + 4 * std::min(x, y);
+ };
+ std::vector<Node> nodes(cells.size());
+ std::priority_queue<Entry> open;
+ nodes[a->second].g = 0;
+ open.push({heuristic(from), 0, a->second});
+ while (!open.empty()) {
+  Entry e = open.top(); open.pop();
+  Node &n = nodes[e.id];
+  if (n.closed || n.g != e.g) continue;
+  if (e.id == b->second) {
+   for (int i = e.id; i != a->second; i = nodes[i].parent) result.push_back(cells[i]);
+   std::reverse(result.begin(), result.end());
+   return result;
+  }
+  n.closed = true;
+  for (int dy = -1; dy <= 1; ++dy) for (int dx = -1; dx <= 1; ++dx) {
+   if (!dx && !dy) continue;
+   Cell next(cells[e.id].first + dx, cells[e.id].second + dy);
+   auto found = ids.find(next);
+   if (found == ids.end()) continue;
+   Node &other = nodes[found->second];
+   int cost = n.g + ((dx && dy) ? 14 : 10);
+   if (other.closed || cost >= other.g) continue;
+   other.g = cost; other.parent = e.id;
+   open.push({cost + heuristic(next), cost, found->second});
+  }
+ }
+ return result;
+}
+}
+}
