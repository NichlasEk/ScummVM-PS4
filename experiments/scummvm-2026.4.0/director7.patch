+// Local compatibility rules for the opt-in PS4 Jonssonligan experiment.
+#ifndef DIRECTOR_PS4_JONSSON_H
+#define DIRECTOR_PS4_JONSSON_H
+#include "common/config-manager.h"
+#include "director/director.h"
+namespace Director {
+inline bool isPS4Jonsson() {
+#ifdef __PS4__
+ const Common::String gameId(g_director->getGameId());
+ return (gameId == "jonssonligan1" || gameId == "jonssonligan2") &&
+  ConfMan.hasKey("ps4_director7_experimental") && ConfMan.getBool("ps4_director7_experimental");
+#else
+ return false;
+#endif
+}
+
+// Match FileIO's virtual filename for Mjolner's baFileExists check. Only
+// the game's save directory is redirected; ordinary assets keep normal lookup.
+inline Common::String ps4JonssonSaveName(Common::String path, const Common::String &prefix) {
+	for (uint i = 0; i < path.size(); ++i)
+		if (path[i] == '\\') path.setChar('/', i);
+	const size_t slash = path.findLastOf('/');
+	if (slash == Common::String::npos || slash + 1 == path.size())
+		return Common::String();
+	Common::String directory = path.substr(0, slash);
+	directory.toLowercase();
+	if (directory != "sparade spel" && !directory.hasSuffix("/sparade spel"))
+		return Common::String();
+	Common::String filename = path.substr(slash + 1);
+	if (!filename.hasSuffixIgnoreCase(".txt"))
+		filename += ".txt";
+	if (!filename.hasPrefixIgnoreCase(prefix))
+		filename = prefix + filename;
+	return filename;
+}
+
+}
