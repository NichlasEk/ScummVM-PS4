+	static uint next = 0;
+	for (uint i = 0; i < 4; ++i)
+		if (cache[i].source == text)
+			return cache[i].decoded;
+	Entry &entry = cache[next];
+	next = (next + 1) % 4;
+	entry.source = text;
+	entry.decoded = text.decode(Common::kUtf8);
+	return entry.decoded;
+}
