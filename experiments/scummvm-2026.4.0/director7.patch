+static const MethodProto methods[] = {
+ {"new", KePathXtra::m_new, 0, 0, 700},
+ {"Path", KePathXtra::m_path, 3, 3, 700},
+ {"Path2", KePathXtra::m_path, 3, 3, 700},
+ {"SetMap", KePathXtra::m_setMap, 1, 1, 700},
+ {"FindPath", KePathXtra::m_findPath, 2, 2, 700},
+ {nullptr, nullptr, 0, 0, 0}
+};
+void KePathXtra::open(ObjectType type, const Common::Path &) {
+ KePathXtraObject::initMethods(methods);
+ auto *obj = new KePathXtraObject(type);
+ g_lingo->_openXtras.push_back(xlibName);
+ g_lingo->_openXtraObjects.push_back(obj);
+ g_lingo->exposeXObject(xlibName, obj);
+}
+void KePathXtra::close(ObjectType) {
+ KePathXtraObject::cleanupMethods();
+ g_lingo->_globalvars[xlibName] = Datum();
+}
+void KePathXtra::m_new(int) { g_lingo->push(g_lingo->_state->me); }
+void KePathXtra::m_setMap(int) {
+ auto *obj = static_cast<KePathXtraObject *>(g_lingo->_state->me.u.obj);
+ obj->map = g_lingo->pop();
+ g_lingo->push(Datum(0));
+}
+static bool gridCell(const Datum &d, KePathGrid::Cell &cell) {
+ if ((d.type != ARRAY && d.type != POINT) || d.u.farr->arr.size() != 2) return false;
+ const Datum &x = d.u.farr->arr[0], &y = d.u.farr->arr[1];
+ if (x.type != INT || y.type != INT || x.u.i < -32768 || x.u.i > 32767 || y.u.i < -32768 || y.u.i > 32767) return false;
+ cell = KePathGrid::Cell(x.u.i, y.u.i);
+ return true;
+}
+void KePathXtra::m_findPath(int) {
+ Datum to = g_lingo->pop(), from = g_lingo->pop();
+ auto *obj = static_cast<KePathXtraObject *>(g_lingo->_state->me.u.obj);
+ Datum result; result.type = ARRAY; result.u.farr = new FArray;
+ KePathGrid::Cell start, goal;
+ if (obj->map.type != ARRAY || obj->map.u.farr->arr.size() > 65536 || !gridCell(from, start) || !gridCell(to, goal)) {
+  warning("KePath: invalid map or endpoints"); g_lingo->push(result); return;
+ }
+ std::vector<KePathGrid::Cell> cells;
+ for (const auto &d : obj->map.u.farr->arr) {
+  KePathGrid::Cell cell;
+  if (!gridCell(d, cell)) { warning("KePath: invalid grid cell"); g_lingo->push(result); return; }
+  cells.push_back(cell);
+ }
+ for (auto cell : KePathGrid::find(cells, start, goal)) {
+  Datum d; d.type = ARRAY; d.u.farr = new FArray;
+  d.u.farr->arr.push_back(Datum(cell.first)); d.u.farr->arr.push_back(Datum(cell.second));
+  result.u.farr->arr.push_back(d);
+ }
+ g_lingo->push(result);
+}
+void KePathXtra::m_path(int) {
+ Datum to = g_lingo->pop(), from = g_lingo->pop(), map = g_lingo->pop();
+ g_lingo->push(map); m_setMap(1); g_lingo->pop();
+ g_lingo->push(from); g_lingo->push(to); m_findPath(2);
+}
+}
