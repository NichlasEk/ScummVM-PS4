+
+const Graphics::Font *TextXtraCastMember::dialogueFont() {
+	if (!isDialogueText())
+		return nullptr;
+	if (!_dialogueFontChecked) {
+		_dialogueFontChecked = true;
+#ifdef USE_FREETYPE2
+		// Decode the original embedded font once, entirely in memory. No
+		// external TTF, extracted game asset or user conversion is required.
+		Archive *archive = _cast->getArchive().get();
+		const uint32 tag = MKTAG('X', 'M', 'E', 'D');
+		for (uint16 id : archive->getResourceIDList(tag)) {
+			const uint32 size = archive->getResourceSize(tag, id);
+			if (size < 58 || size > 4 * 1024 * 1024) continue;
+			Common::SeekableReadStreamEndian *resource = archive->getResource(tag, id);
+			if (resource->readUint32BE() != MKTAG('P', 'F', 'R', '1')) {
+				delete resource;
+				continue;
+			}
+			resource->seek(0);
+			Common::Array<byte> data(size);
+			const bool readOK = resource->read(data.data(), size) == size;
+			delete resource;
+			unsigned char *ttf = nullptr;
+			size_t ttfSize = 0;
+			if (!readOK || !director_pfr1_to_ttf(data.data(), size, &ttf, &ttfSize)) continue;
+			Common::MemoryReadStream stream(ttf, ttfSize, DisposeAfterUse::NO);
+			// loadTTFFont retains its stream for late glyph loading. Copy into
+			// a stream owned by the font before releasing the converter buffer.
+			Common::SeekableReadStream *owned = stream.readStream(ttfSize);
+			director_pfr1_free(ttf);
+			_dialogueFont.reset(Graphics::loadTTFFont(owned, DisposeAfterUse::YES,
+					9, Graphics::kTTFSizeModeCharacter, 0, 0, Graphics::kTTFRenderModeLight));
+			if (_dialogueFont) {
+				warning("Embedded dialogue font loaded from XMED %u", id);
+				break;
+			}
+		}
+#endif
+	}
+	return _dialogueFont.get();
+}
