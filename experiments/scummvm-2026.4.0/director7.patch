+// Cache immutable text values, not variable addresses: Lingo can reassign or
+// edit a field between reads. Content comparison also covers in-place edits.
+// Large unchanged save/scene strings otherwise get decoded for every chunk.
+static Common::U32String decodePS4ChunkText(const Common::String &text) {
+	if (!isPS4Jonsson() || text.size() < 1024 || text.size() > 1024 * 1024)
+		return text.decode(Common::kUtf8);
+	struct Entry { Common::String source; Common::U32String decoded; };
