+		CastMemberInfo *info = channel->_sprite->_cast->getInfo();
+		if (!info || !info->name.hasPrefix("cursor_"))
+			continue;
+		if (channel->getPosition() == pos)
+			return false;
+		channel->setPosition(pos.x, pos.y);
+		channel->setNeedsDraw();
+		return true;
+	}
+	return false;
