+    std::vector<std::uint8_t> imageData;
+    if (imageFormat == 0) {
+        const int expected = (totalBits + 7) / 8;
+        if (expected > remaining || expected <= 0) {
+            throw std::runtime_error("bitmap glyph packed data invalid");
