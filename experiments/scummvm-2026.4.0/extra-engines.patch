+	while (path.hasPrefix("./")) path = path.substr(2);
+	return path;
+}
+
+Audio::SeekableAudioStream *loadAudio(const Common::String &path) {
+	auto *file = SearchMan.createReadStreamForMember(Common::Path(path));
+	if (!file) return nullptr;
+	if (path.hasSuffixIgnoreCase(".wav"))
+		return Audio::makeWAVStream(file, DisposeAfterUse::YES);
+#ifdef USE_MAD
+	if (path.hasSuffixIgnoreCase(".mp3"))
+		return Audio::makeMP3Stream(file, DisposeAfterUse::YES);
+#endif
+	delete file;
+	return nullptr;
+}
+
+void updateChannel(SoundChannel &channel) {
+	if (!g_system->getMixer()->isSoundHandleActive(channel.handle)) return;
+	float gain = 1.f;
+	int balance = 0;
+	if (!channel.diffuse) {
+		const auto &s = channel.sound;
+		const float dx = s.v3flPosition.x - listener.v3flPosition.x;
+		const float dy = s.v3flPosition.y - listener.v3flPosition.y;
+		const float dz = s.v3flPosition.z - listener.v3flPosition.z;
+		const float distance = sqrtf(dx * dx + dy * dy + dz * dz);
+		if (s.flMaxDistance > s.flMinDistance && distance > s.flMinDistance)
+			gain = MAX(0.f, (s.flMaxDistance - distance) / (s.flMaxDistance - s.flMinDistance));
+		// Listener front/top define the horizontal right vector in game space.
+		const auto &f = listener.v3flFrontOrientation;
+		const auto &t = listener.v3flTopOrientation;
+		const float rx = t.y*f.z-t.z*f.y, ry = t.z*f.x-t.x*f.z, rz = t.x*f.y-t.y*f.x;
+		const float length = sqrtf(rx*rx+ry*ry+rz*rz);
+		if (distance > 0.f && length > 0.f)
+			balance = CLIP<int>((int)(127.f * (dx*rx+dy*ry+dz*rz)/(distance*length)), -127, 127);
+	}
+	const byte volume = channel.sound.dwFlags & SOUND_SPEECH ? speechVolume : soundVolume;
+	g_system->getMixer()->setChannelVolume(channel.handle, (byte)(volume * gain));
+	g_system->getMixer()->setChannelBalance(channel.handle, balance);
+}
+
+bool startSound(sSound *sound, bool reload, bool diffuse) {
+	if (!sound || !sound->name[0]) return false;
+	SoundChannel *slot = nullptr;
+	for (auto &channel : channels) {
+		if (g_system->getMixer()->isSoundHandleActive(channel.handle)) {
+			if (channel.sound.lIndex == sound->lIndex) {
+				if (!reload && sound->dwLooped) return true;
+				g_system->getMixer()->stopHandle(channel.handle);
+				slot = &channel;
+				break;
+			}
+		} else if (!slot) slot = &channel;
+	}
+	if (!slot) return false;
+	Common::String path = soundPath(sound->name);
+	auto *stream = loadAudio(path);
+	if (!stream) {
+		warning("Watchmaker audio: cannot decode %s", path.c_str());
+		return false;
+	}
+	slot->sound = *sound;
+	slot->diffuse = diffuse || (sound->dwFlags & SOUND_SPEECH);
+	Audio::AudioStream *playback = stream;
+	if (sound->dwLooped) playback = Audio::makeLoopingAudioStream(stream, 0);
+	g_system->getMixer()->playStream(sound->dwFlags & SOUND_SPEECH ? Audio::Mixer::kSpeechSoundType : Audio::Mixer::kSFXSoundType,
+		&slot->handle, playback);
+	updateChannel(*slot);
+	debug(1, "Watchmaker audio: playing %s", path.c_str());
 	return true;
 }
