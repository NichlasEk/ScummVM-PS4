+// SPDX-License-Identifier: GPL-3.0-or-later
+#ifndef BACKENDS_FS_POSIX_PS4_DIRENT_H
+#define BACKENDS_FS_POSIX_PS4_DIRENT_H
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+// PS4/FreeBSD getdents records: ino32, reclen16, type8, namlen8, name.
+// Never dereference a record or construct a string before validating bounds.
+static inline bool ps4DirentRecord(const uint8_t *data, size_t available,
+                                  uint16_t &recordSize, uint8_t &nameSize) {
+ recordSize = nameSize = 0;
+ if (!data || available < 9) return false;
+ const uint16_t length = uint16_t(data[4]) | (uint16_t(data[5]) << 8);
+ const uint8_t names = data[7];
+ if (length < 9 || length > available || names == 0 || size_t(names) + 9 > length)
+  return false;
+ if (data[8 + names] != 0 || memchr(data + 8, 0, names) || memchr(data + 8, '/', names))
+  return false;
+ recordSize = length; nameSize = names; return true;
+}
+#endif
