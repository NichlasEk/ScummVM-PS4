--- a/glslang/MachineIndependent/PoolAlloc.cpp
+++ b/glslang/MachineIndependent/PoolAlloc.cpp
@@ -38,14 +38,33 @@
 namespace glslang {
 
 namespace {
+#ifdef __ORBIS__
+// PS4 frontend owns one compiler thread; OpenOrbis lacks TLS destructors.
+TPoolAllocator* threadPoolAllocator = nullptr;
+TPoolAllocator* defaultAllocator = nullptr;
+#else
 thread_local TPoolAllocator* threadPoolAllocator = nullptr;
+#endif
 
 TPoolAllocator* GetDefaultThreadPoolAllocator()
 {
+#ifdef __ORBIS__
+    if (!defaultAllocator) defaultAllocator = new TPoolAllocator;
+    return defaultAllocator;
+#else
     thread_local TPoolAllocator defaultAllocator;
     return &defaultAllocator;
+#endif
 }
 } // anonymous namespace
+#ifdef __ORBIS__
+void ReleaseDefaultThreadPoolAllocator()
+{
+    threadPoolAllocator = nullptr;
+    delete defaultAllocator;
+    defaultAllocator = nullptr;
+}
+#endif
 
 // Return the thread-specific current pool.
 TPoolAllocator& GetThreadPoolAllocator()
