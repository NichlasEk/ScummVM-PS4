+/* The standalone buffer-table ABI currently supports plain UBO bindings in
+ * set 0, without descriptor arrays. Reject other resources explicitly instead
+ * of accepting the upstream null-descriptor fallback as a working shader.
+ */
+static bool psbc_supported_resources(nir_shader *nir, PsbcTarget target) {
+    nir_foreach_variable_with_modes(var, nir, nir_var_mem_ssbo | nir_var_image | nir_var_mem_push_const)
+        return false;
+    nir_foreach_function_impl(impl, nir) {
+        nir_foreach_block(block, impl) {
+            nir_foreach_instr(instr, block) {
+                if (instr->type == nir_instr_type_tex)
+                    return false;
+                if (instr->type != nir_instr_type_intrinsic)
+                    continue;
+                nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+                switch (intr->intrinsic) {
+                case nir_intrinsic_vulkan_resource_index:
+                    if (target == PSBC_TARGET_PS5 ||
+                        (nir->info.stage != MESA_SHADER_VERTEX && nir->info.stage != MESA_SHADER_FRAGMENT) ||
+                        nir_intrinsic_desc_type(intr) != nir_descriptor_type_uniform_buffer ||
+                        nir_intrinsic_desc_set(intr) != 0 || nir_intrinsic_binding(intr) >= 16 ||
+                        !nir_src_is_const(intr->src[0]) || nir_src_as_uint(intr->src[0]) != 0)
+                        return false;
+                    break;
+                case nir_intrinsic_load_vulkan_descriptor:
+                    if (nir_intrinsic_desc_type(intr) != nir_descriptor_type_uniform_buffer)
+                        return false;
+                    break;
+                case nir_intrinsic_load_ubo: {
+                    nir_binding binding = nir_chase_binding(intr->src[0]);
+                    if (!binding.success || (nir_intrinsic_access(intr) & ACCESS_NON_UNIFORM))
+                        return false;
+                    for (unsigned i = 0; i < binding.num_indices; ++i)
+                        if (!nir_src_is_const(binding.indices[i]) || nir_src_as_uint(binding.indices[i]) != 0)
+                            return false;
+                    break;
+                }
+                case nir_intrinsic_vulkan_resource_reindex:
+                case nir_intrinsic_load_push_constant:
+                case nir_intrinsic_load_ssbo:
+                case nir_intrinsic_store_ssbo:
+                case nir_intrinsic_ssbo_atomic:
+                case nir_intrinsic_ssbo_atomic_swap:
+                    return false;
+                default:
+                    break;
+                }
+            }
+        }
+    }
+    return true;
+}
