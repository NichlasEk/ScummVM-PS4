+bool Director7PCMDecoder::load(Common::SeekableReadStreamEndian &header, Common::SeekableReadStreamEndian &samples) {
+ if (header.size() < 100) return false;
+ header.seek(44); _rate = header.readUint32BE();
+ header.seek(52);
+ for (int i = 0; i < 16; ++i) if (header.readByte()) return false; // PCM GUID
+ _bits = header.readUint32BE();
+ uint32 bytes = header.readUint32BE();
+ _channels = header.readUint32BE();
+ uint32 frameBytes = header.readUint32BE();
+ if (!_rate || _rate > 192000 || (_bits != 8 && _bits != 16) ||
+     (_channels != 1 && _channels != 2) || bytes != _bits / 8 ||
+     frameBytes != bytes * _channels || samples.size() <= 0 || samples.size() % frameBytes)
+  return false;
+ _samples.resize(samples.size());
+ return samples.read(_samples.data(), _samples.size()) == _samples.size();
+}
+Audio::AudioStream *Director7PCMDecoder::getAudioStream(bool looping, bool forPuppet, DisposeAfterUse::Flag disposeAfterUse) {
+ if (_samples.empty()) return nullptr;
+ byte *copy = (byte *)malloc(_samples.size());
+ if (!copy) return nullptr;
+ memcpy(copy, _samples.data(), _samples.size());
+ byte flags = (_bits == 16 ? Audio::FLAG_16BITS : Audio::FLAG_UNSIGNED) |
+              (_channels == 2 ? Audio::FLAG_STEREO : 0);
+ Audio::SeekableAudioStream *audio = Audio::makeRawStream(copy, _samples.size(), _rate, flags, DisposeAfterUse::YES);
+ if (looping) return new Audio::LoopingAudioStream(audio, 0);
+ return audio;
+}
