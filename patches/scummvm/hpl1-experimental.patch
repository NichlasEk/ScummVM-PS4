+/* Black Plague humanoid AI. Shared navigation, perception, physics and save
+ * state remain in iGameEnemy; no quadruped jump/eat/rise states are reused. */
+class cGameEnemy_Infected;
+class cInfectedState : public iGameEnemyState {
+public:
+ cInfectedState(int id, cInit *init, iGameEnemy *enemy) : iGameEnemyState(id,init,enemy) {}
+ void OnEnterState(iGameEnemyState *) override;
+ void OnLeaveState(iGameEnemyState *) override {}
+ void OnUpdate(float dt) override;
+ void OnDraw() override {}
+ void OnPostSceneDraw() override {}
+ void OnSeePlayer(const cVector3f &pos, float chance) override;
+ bool OnHearNoise(const cVector3f &pos,float volume) override;
+ void OnTakeHit(float damage) override;
+ void OnDeath(float) override { mpEnemy->ChangeState(STATE_DEAD); }
+ void OnAnimationOver(const tString &) override;
+ void OnFlashlight(const cVector3f &pos) override { OnHearNoise(pos,1.f); }
+};
+class cGameEnemy_Infected : public iGameEnemy {
+public:
+ float attackRange,attackTime,minDamage,maxDamage,huntSpeed,idleFov,huntFov;
+ float seeChance,hearVolume,timer,repath;
+ bool hit,waiting;
+ tString hitSound;
+ cLight3DSpot *flashlight = nullptr;
+ cGameEnemy_Infected(cInit *init,const tString &name,TiXmlElement *game) : iGameEnemy(init,name,game) {
+  LoadBaseProperties(game);
+  attackRange=cString::ToFloat(game->Attribute("AttackDamageRange"),1.5f);
+  attackTime=cString::ToFloat(game->Attribute("AttackStillDamageTime"),0.5f);
+  minDamage=cString::ToFloat(game->Attribute("AttackMinDamage"),10.f);
+  maxDamage=cString::ToFloat(game->Attribute("AttackMaxDamage"),10.f);
+  huntSpeed=cString::ToFloat(game->Attribute("HuntSpeed"),3.f);
+  idleFov=cMath::ToRad(cString::ToFloat(game->Attribute("IdleFOV"),90.f));
+  huntFov=cMath::ToRad(cString::ToFloat(game->Attribute("HuntFOV"),120.f));
+  seeChance=cString::ToFloat(game->Attribute("IdleMinSeeChance"),0.3f);
+  hearVolume=cString::ToFloat(game->Attribute("IdleMinHearVolume"),0.3f);
+  hitSound=cString::ToString(game->Attribute("AttackHitSound"),"");
+  timer=repath=0; hit=waiting=false;
+  // Existing scripts and serialized states use these stable state IDs.
+  for(int i=0;i<STATE_NUM;++i) AddState(hplNew(cInfectedState,(i,init,this)));
+ }
+ void OnLoad() override { ChangeState(STATE_IDLE); }
+ void OnUpdate(float) override {
+  if(flashlight) flashlight->SetVisible(IsActive());
+ }
+ void AddFlashlight() override {
+  if(flashlight)return;
+  mbHasFlashlight=true;
+  flashlight=mpInit->mpGame->GetScene()->GetWorld3D()->CreateLightSpot(msName+"_flashlight", "",false);
+  flashlight->SetFOV(cMath::ToRad(45));flashlight->SetAspect(1);
+  flashlight->SetFarAttenuation(12);flashlight->SetDiffuseColor(cColor(1,1,0.8f,1));
+  flashlight->SetCastShadows(true);
+  if(!mpMeshEntity->AttachEntityToParent(flashlight,"LeftHand"))warning("Cannot attach Infected flashlight to LeftHand");
+  mvLights.push_back(flashlight);
+  msStoppedAnim="IdleFlashlight";msWalkAnim="WalkFlashlight";msRunAnim="RunFlashlight";
+ }
+ bool MoveToPos(const cVector3f &pos) override {
+  SetTempPosition(pos); ChangeState(STATE_MOVETO); return mpMover->MoveToPos(pos);
+ }
+ void ShowPlayer(const cVector3f &pos) override { SetLastPlayerPos(pos); ChangeState(STATE_HUNT); }
+ bool IsFighting() override { return mlCurrentState==STATE_HUNT || mlCurrentState==STATE_ATTACK; }
+ void Animate(const tString &name,bool loop) {
+  if(mpMeshEntity->GetAnimationStateFromName(name)) PlayAnim(name,loop,0.2f);
+  else UseMoveStateAnimations();
+ }
+};
+void cInfectedState::OnEnterState(iGameEnemyState *) {
+ cGameEnemy_Infected *e=static_cast<cGameEnemy_Infected *>(mpEnemy);
+ e->timer=0; e->repath=0; e->hit=false; e->waiting=false;
+ if(mlId==STATE_DEAD) {
+  mpMover->Stop(); mpEnemy->GetMeshEntity()->SetSkeletonPhysicsActive(true);
+  mpMover->GetCharBody()->SetActive(false);
+  mpInit->mpMusicHandler->RemoveAttacker(mpEnemy); return;
+ }
+ mpEnemy->SetupBody(); mpEnemy->UseMoveStateAnimations();
+ mpEnemy->SetFOV(mlId==STATE_HUNT ? e->huntFov : e->idleFov);
+ if(mlId==STATE_HUNT) mpMover->GetCharBody()->SetMaxPositiveMoveSpeed(eCharDir_Forward,e->huntSpeed);
+ if(mlId==STATE_ATTACK) { mpMover->Stop(); e->Animate("SwingClawsStill_01",false); }
+ if(mlId==STATE_KNOCKDOWN) { mpMover->Stop(); e->Animate("Flinch",false); }
+ if(mlId==STATE_IDLE || mlId==STATE_PATROL) mpInit->mpMusicHandler->RemoveAttacker(mpEnemy);
+}
+void cInfectedState::OnSeePlayer(const cVector3f &pos,float chance) {
+ cGameEnemy_Infected *e=static_cast<cGameEnemy_Infected *>(mpEnemy);
+ if(mlId==STATE_DEAD || chance<e->seeChance) return;
+ mpEnemy->SetLastPlayerPos(pos);
+ if(mlId!=STATE_ATTACK && mlId!=STATE_HUNT && mlId!=STATE_KNOCKDOWN) mpEnemy->ChangeState(STATE_HUNT);
+}
+bool cInfectedState::OnHearNoise(const cVector3f &pos,float volume) {
+ cGameEnemy_Infected *e=static_cast<cGameEnemy_Infected *>(mpEnemy);
+ if(mlId==STATE_DEAD || mlId==STATE_HUNT || mlId==STATE_ATTACK || volume<e->hearVolume) return false;
+ mpEnemy->SetTempPosition(pos);mpEnemy->ChangeState(STATE_INVESTIGATE);return true;
+}
+void cInfectedState::OnTakeHit(float damage) {
+ if(mlId!=STATE_DEAD && damage>0) mpEnemy->ChangeState(STATE_KNOCKDOWN);
+}
+void cInfectedState::OnAnimationOver(const tString &) {
+ if(mlId==STATE_ATTACK || mlId==STATE_KNOCKDOWN) mpEnemy->ChangeState(STATE_HUNT);
+}
+void cInfectedState::OnUpdate(float dt) {
+ cGameEnemy_Infected *e=static_cast<cGameEnemy_Infected *>(mpEnemy);
+ e->timer+=dt; e->repath-=dt;
+ if(mlId==STATE_DEAD) return;
+ if(mlId==STATE_IDLE) { if(mpEnemy->GetPatrolNodeNum()) mpEnemy->ChangeState(STATE_PATROL); return; }
+ if(mlId==STATE_PATROL) {
+  if(!mpEnemy->GetPatrolNodeNum()) {mpEnemy->ChangeState(STATE_IDLE);return;}
+  if(mpMover->IsMoving()) return;
+  if(e->waiting) {
+   if(e->timer<mpEnemy->GetWaitTime()) return;
+   mpEnemy->IncCurrentPatrolNode(); e->waiting=false;mpEnemy->UseMoveStateAnimations();
+  }
+  cEnemyPatrolNode *patrol=mpEnemy->CurrentPatrolNode();
+  cAINode *node=mpMover->GetNodeContainer() ? mpMover->GetNodeContainer()->GetNodeFromName(patrol->msNodeName) : nullptr;
+  if(!node) {warning("Infected patrol node '%s' is missing",patrol->msNodeName.c_str());mpEnemy->ChangeState(STATE_IDLE);return;}
+  if(cMath::Vector3DistSqr(mpMover->GetCharBody()->GetFeetPosition(),node->GetPosition())<0.5f) {
+   mpEnemy->SetWaitTime(patrol->mfWaitTime);e->waiting=true;e->timer=0;
+   if(patrol->msAnimation!="") e->Animate(patrol->msAnimation,false);
+  } else if(e->repath<=0) {mpMover->MoveToPos(node->GetPosition());e->repath=1;}
+  return;
+ }
+ if(mlId==STATE_HUNT) {
+  if(mpEnemy->CanSeePlayer()) mpEnemy->SetLastPlayerPos(mpPlayer->GetCharacterBody()->GetFeetPosition());
+  float distance=mpMover->DistanceToChar(mpPlayer->GetCharacterBody());
+  if(distance<=e->attackRange && mpMover->FreeDirectPathToChar(mpPlayer->GetCharacterBody())) {mpEnemy->ChangeState(STATE_ATTACK);return;}
+  if(e->repath<=0) {mpMover->MoveToPos(mpEnemy->GetLastPlayerPos());e->repath=0.5f;}
+  if(e->timer>15 && !mpEnemy->CanSeePlayer() && !mpMover->IsMoving()) mpEnemy->ChangeState(STATE_IDLE);
+  return;
+ }
+ if(mlId==STATE_ATTACK) {
+  mpMover->TurnToPos(mpPlayer->GetCharacterBody()->GetFeetPosition());
+  if(!e->hit && e->timer>=e->attackTime) {
+   e->hit=true;
+   if(mpMover->DistanceToChar(mpPlayer->GetCharacterBody())<=e->attackRange && mpMover->FreeDirectPathToChar(mpPlayer->GetCharacterBody())) {
+    mpPlayer->Damage(cMath::RandRectf(e->minDamage,e->maxDamage),ePlayerDamageType_BloodSplash);
+    mpEnemy->PlaySound(e->hitSound);
+   }
+  }
+  if(e->timer>2) mpEnemy->ChangeState(STATE_HUNT);
+  return;
+ }
+ if(mlId==STATE_KNOCKDOWN) {if(e->timer>1)mpEnemy->ChangeState(STATE_HUNT);return;}
+ if(mlId==STATE_INVESTIGATE || mlId==STATE_MOVETO) {
+  if(e->timer<=dt) mpMover->MoveToPos(mpEnemy->GetTempPosition());
+  if(!mpMover->IsMoving() && e->timer>0.5f)mpEnemy->ChangeState(STATE_IDLE);
+  return;
+ }
+ // Non-humanoid state IDs in old saves/scripts return to normal patrol.
+ mpEnemy->ChangeState(STATE_IDLE);
+}
