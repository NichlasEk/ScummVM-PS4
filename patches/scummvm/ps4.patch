--- /dev/null
+++ b/backends/graphics/surfacesdl/ps4-framebuffer.h
@@ -0,0 +1,38 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#ifndef BACKENDS_GRAPHICS_PS4_FRAMEBUFFER_H
+#define BACKENDS_GRAPHICS_PS4_FRAMEBUFFER_H
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+// Opaque RGB565 -> native 32-bit framebuffer, nearest-neighbour scaling.
+// Destination rectangle must be contained in the framebuffer. Pitch is bytes.
+static inline bool ps4Scale565(const void *src, int sw, int sh, int sp,
+                               void *dst, int dw, int dh, int dp,
+                               int vx, int vy, int vw, int vh,
+                               const uint32_t *colors) {
+ if (!src || !dst || !colors || sw <= 0 || sh <= 0 || dw <= 0 || dh <= 0 ||
+     sw > 4096 || sh > 4096 || dw > 4096 || dh > 4096 ||
+     sp < sw*2 || dp < dw*4 || vx < 0 || vy < 0 || vw <= 0 || vh <= 0 ||
+     vx > dw || vy > dh || vw > dw-vx || vh > dh-vy) return false;
+ int columns[4096];
+ for (int x = 0; x < vw; ++x) columns[x] = ((2*x+1)*sw)/(2*vw);
+ int previous = -1;
+ for (int y = 0; y < dh; ++y) {
+  uint8_t *row = static_cast<uint8_t *>(dst) + size_t(y)*dp;
+  if (y < vy || y >= vy+vh) { memset(row, 0, dw*4); continue; }
+  int sy = ((2*(y-vy)+1)*sh)/(2*vh);
+  if (sy == previous) { memcpy(row, row-dp, dw*4); continue; }
+  memset(row, 0, vx*4);
+  memset(row+(vx+vw)*4, 0, (dw-vx-vw)*4);
+  const uint8_t *source = static_cast<const uint8_t *>(src) + size_t(sy)*sp;
+  for (int x = 0; x < vw; ++x) {
+   uint16_t pixel;
+   memcpy(&pixel, source+columns[x]*2, 2);
+   uint32_t color = colors[pixel];
+   memcpy(row+(vx+x)*4, &color, 4);
+  }
+  previous = sy;
+ }
+ return true;
+}
+#endif
