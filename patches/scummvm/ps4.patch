 bool POSIXFilesystemNode::exists() const {
+	#ifdef __PS4__
+	// OpenOrbis/shadPS4 does not provide a usable access() implementation.
+	struct stat st;
+	if (stat(_path.c_str(), &st) != 0)
+		return false;
+	return true;
+#else
 	return access(_path.c_str(), F_OK) == 0;
+#endif
 }
 
 bool POSIXFilesystemNode::isReadable() const {
+	#ifdef __PS4__
+	// OpenOrbis/shadPS4 does not provide a usable access() implementation.
+	struct stat st;
+	if (stat(_path.c_str(), &st) != 0)
+		return false;
+	return (st.st_mode & (S_IRUSR | S_IRGRP | S_IROTH)) != 0;
+#else
 	return access(_path.c_str(), R_OK) == 0;
+#endif
 }
 
 bool POSIXFilesystemNode::isWritable() const {
+	#ifdef __PS4__
+	// OpenOrbis/shadPS4 does not provide a usable access() implementation.
+	struct stat st;
+	if (stat(_path.c_str(), &st) != 0)
+		return false;
+	if (_path == "/app0" || _path.hasPrefix("/app0/"))
+		return false;
+	return (st.st_mode & (S_IWUSR | S_IWGRP | S_IWOTH)) != 0;
+#else
 	return access(_path.c_str(), W_OK) == 0;
+#endif
 }
 
